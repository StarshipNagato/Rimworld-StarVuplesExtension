<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- 修改敲击兽移动速度 -->
  <Operation Class="PatchOperationReplace">
      <xpath>*/ThingDef[defName = "Thrumbo"]/statBases/MoveSpeed</xpath> <!-- 查找敲击兽的移动速度 -->
      <value>
          <MoveSpeed>8.6</MoveSpeed> <!-- 将移动速度设置为8.6 -->
      </value>
  </Operation>

  <!-- 修改敲击兽污物规模 -->
  <Operation Class="PatchOperationReplace">
      <xpath>*/ThingDef[defName = "Thrumbo"]/statBases/FilthRate</xpath> <!-- 查找敲击兽的污物规模 -->
      <value>
          <FilthRate>1.75</FilthRate> <!-- 将污物规模设置为1.75 -->
      </value>
  </Operation>

  <!-- 修改敲击兽的骑行速度 -->
  <Operation Class="PatchOperationReplace">
      <xpath>*/ThingDef[defName = "Thrumbo"]/statBases/CaravanRidingSpeedFactor</xpath> <!-- 查找敲击兽的骑行速度 -->
      <value>
          <CaravanRidingSpeedFactor>4</CaravanRidingSpeedFactor> <!-- 将骑行速度设置为4 -->
      </value>
  </Operation>

  <!-- 为敲击兽添加驮兽的属性 -->
  <Operation Class="PatchOperationAdd">
      <xpath>*/ThingDef[defName = "Thrumbo"]/race</xpath> <!-- 查找敲击兽物品的种族信息 -->
      <value>
          <packAnimal>true</packAnimal> <!-- 将其设置为驮兽 -->
      </value>
  </Operation>

  <!-- 为敲击兽添加可剪毛的组件 -->
  <Operation Class="PatchOperationAdd">
      <xpath>*/ThingDef[defName = "Thrumbo"]</xpath> <!-- 查找敲击兽 -->
      <value>
          <comps> <!-- 添加组件 -->
              <li Class="CompProperties_Shearable"> <!-- 剪毛组件 -->
                  <woolDef>ThrumboWool</woolDef> <!-- 设置剪下的毛是ThrumboWool敲击兽毛 -->
                  <shearIntervalDays>15</shearIntervalDays> <!-- 设置剪毛间隔为15天 -->
                  <woolAmount>100</woolAmount> <!-- 每次剪毛得到100单位的毛 -->
              </li>
          </comps>
      </value>
  </Operation>

</Patch>