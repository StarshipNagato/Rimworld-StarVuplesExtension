<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 所有武器的基础定义库，首先继承自原版BaseWeapons中最基础的BaseWeapon -->
  <!-- ================ 远程武器 ================ -->
  <!-- 无品质无艺术的远程武器 -->
  <ThingDef Name="SV_GeneralWeaponBase" ParentName="BaseGun" Abstract="True"> <!-- 定义一个继承自BaseGun的武器，名称SV_GeneralWeaponBase,无品质 --> <!-- 这里重新引用自BaseGun是为了去除"CompProperties_Art"有关艺术的内容 -->
    <comps Inherit="false"> <!-- 引用"BaseGun"类但不继承comps的内容以去除艺术，需要重新定义comps里的条目 -->
      <li Class="CompProperties_Forbiddable"/> <!-- 允许物品可以被设置为禁止互动 -->
      <li>
        <compClass>CompEquippable</compClass> <!-- 允许被装备 -->
      </li>
      <li Class="CompProperties_Styleable"/> <!-- 支持风格类型，如文化中的轻重武器、颜色和风格、时代武器等 -->
    </comps>
    <smeltable>false</smeltable> <!-- 不允许被熔炼 -->
  </ThingDef>

  <!-- 有品质无艺术的远程武器 -->
  <ThingDef Name="SV_QualityWeaponBase" ParentName="SV_GeneralWeaponBase" Abstract="True">
    <comps>
      <li>
        <compClass>CompQuality</compClass> <!-- 允许有品质 -->
      </li>
    </comps>
    <smeltable Inherit="false">true</smeltable> <!-- 允许被熔炼 -->
  </ThingDef>

  <!-- 无品质无艺术的可制造远程武器 -->
  <ThingDef Name="SV_MakeableWeaponBase" ParentName="SV_GeneralWeaponBase" Abstract="True">
    <smeltable Inherit="false">true</smeltable>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
      <!--<recipeUsers> < 所有引用此项的均可在哪些工作台上加工，暂时留空单独配置 -->
      <!--<li></li>-->
      <!--</recipeUsers>-->
    </recipeMaker>
  </ThingDef>

  <!-- 有品质无艺术的可制造远程武器 -->
  <ThingDef Name="SV_MakeableQualityWeaponBase" ParentName="SV_MakeableWeaponBase" Abstract="True">
    <comps>
      <li>
        <compClass>CompQuality</compClass>
      </li>
    </comps>
  </ThingDef>

  <!-- ================ 近战武器 ================ -->
  <!-- 无品质无艺术的近战武器 -->
  <ThingDef Name="SV_MeleeWeaponBase" ParentName="BaseMeleeWeapon" Abstract="True"> <!-- 定义一个继承自BaseMeleeWeapon的武器，名称SV_MeleeWeaponBase,无品质 --> <!-- 什么叫原版中近战和远程的第一个BaseWeapon写得不一样？ -->
    <inspectorTabs Inherit="false" /> <!-- 不继承艺术描述，原版中远程和近战的这段不一样 -->
    <smeltable>false</smeltable>
    <recipeMaker Inherit="False" /> <!-- 不继承制造相关 -->
  </ThingDef>

  <!-- 有品质无艺术的近战武器 -->
  <ThingDef Name="SV_QualityMeleeWeaponBase" ParentName="SV_MeleeWeaponBase" Abstract="True">
    <comps>
      <li>
        <compClass>CompQuality</compClass>
      </li>
    </comps>
  </ThingDef>

  <!-- 无品质无艺术的可制造近战武器 -->
  <ThingDef Name="SV_MakeableMeleeWeaponBase" ParentName="SV_MeleeWeaponBase" Abstract="True">
    <smeltable Inherit="false">true</smeltable>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
    </recipeMaker>
  </ThingDef>

  <!-- 有品质无艺术的可制造近战武器 -->
  <ThingDef Name="SV_MakeableQualityMeleeWeaponBase" ParentName="SV_MakeableMeleeWeaponBase" Abstract="True">
    <comps>
      <li>
        <compClass>CompQuality</compClass>
      </li>
    </comps>
  </ThingDef>

    <!--
    <recipeUsers>
    <li></li>
    </recipeUsers>
      FabricationBench#精密装配台
      TableMachining#机械加工台
